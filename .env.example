# Local development uses SQLite. Vercel Preview and Production use separate Neon Postgres branches.
DATABASE_URL=file:./hausvermietung-lustenau.db
PAYLOAD_SECRET=YOUR_SECRET_HERE
ENABLE_PUBLIC_INQUIRIES=false
# Server-side only. Add your OpenRouter key locally and in your deployment environment.
OPENROUTER_API_KEY=
# Optional: OPENROUTER_MODEL=openai/gpt-4.1-mini
# Optional locally; automatically set on Vercel after connecting Blob with a read/write token.
# BLOB_READ_WRITE_TOKEN=...
# Required before calendar exports are shared with Airbnb and Booking.com.
ICAL_EXPORT_SECRET=
# Shared by all scheduled endpoints and the GitHub Actions repository secret (at least 32 characters).
CRON_SECRET=
# GitHub Actions also needs CALENDAR_CHECK_URL, e.g. https://example.com/api/internal/calendar-check.
# Email delivery is disabled until both values are configured and the sender domain is verified in Resend.
RESEND_API_KEY=
EMAIL_FROM=
SUPPORT_EMAIL=david@davidkathrein.at
# Bright Data Instagram Posts "Discover by URL". The profile URL is server-side only.
BRIGHTDATA_API_KEY=
INSTAGRAM_PROFILE_URL=
# GitHub Actions also needs INSTAGRAM_SYNC_URL, e.g. https://example.com/api/internal/instagram-sync.
